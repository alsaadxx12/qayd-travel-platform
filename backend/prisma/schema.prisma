/// A scannable, revocable key to ONE account's statement.
///
/// The QR printed on a statement or a receipt carries nothing but `token`. Everything
/// else — which company, which account, whether it still works — is resolved here, so
/// a printed page never carries an id that could be guessed or edited into someone
/// else's statement. `phoneLast4` is not stored: it is compared live against the
/// customer's current phone, so changing the phone changes the answer immediately.
model StatementAccessToken {
  id             String    @id @default(uuid())
  /// The opaque secret in the URL. 32 random bytes, base64url.
  token          String    @unique
  companyId      String
  /// The ledger account whose statement this key opens.
  accountId      String
  customerId     String?
  supplierId     String?
  label          String?
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  /// Wrong-answer counter and lockout, so four digits cannot be brute forced.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  viewCount      Int       @default(0) @map("view_count")
  lastViewedAt   DateTime? @map("last_viewed_at")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@index([accountId])
  @@index([customerId])
  @@index([supplierId])
  @@map("statement_access_tokens")
}

/// تسلسل ترقيم المستندات — عدّادٌ واحد في القاعدة بدل عدّادٍ في كل متصفّح.
///
/// كان الترقيم يُحفظ في localStorage لكل جهاز، فيبدأ موظفان من الرقم نفسه
/// ويصطدمان: أحدهما يحفظ والآخر يفشل. والعدّاد هنا يُخصَّص بعبارة SQL واحدة
/// ذرّية، فلا يأخذ اثنان رقماً واحداً مهما تزامنا.
model DocumentSequence {
  id          String   @id @default(uuid())
  companyId   String
  /// null يعني تسلسلاً عاماً للشركة كلها، لا لفرعٍ بعينه.
  branchId    String?
  /// tickets | visas | groups | refunds | changes | receiptVouchers | paymentVouchers | journalEntries | hotels | exchange
  docType     String
  prefix      String
  branchCode  String   @default("")
  includeYear Boolean  @default(true)
  /// السنة التي يعود إليها العدّاد الحالي؛ تغيّرها يعيد الترقيم من البداية.
  year        Int?
  nextNumber  Int      @default(1001)
  padding     Int      @default(5)
  separator   String   @default("-")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, docType])
  @@index([companyId, docType])
  @@map("document_sequences")
}
