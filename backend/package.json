    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.6",
    "@prisma/client": "^6.3.1",
    "@types/handlebars": "^4.0.40",
    "@types/qrcode": "^1.5.5",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "handlebars": "^4.7.9",
    "openai": "^7.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "puppeteer": "^25.6.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
